# Next.js + Supabase
# Base project URL only — do NOT append /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public site URL — used in emails and shareable gallery links (NOT localhost in production)
NEXT_PUBLIC_APP_URL=https://studio-galleries.com

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Protects /api/cron/* routes (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=random-cron-secret
# Optional — for `npm run supabase:auth-urls` (Dashboard → Account → Access Tokens)
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
GALLERY_SESSION_SECRET=random-secret-for-gallery-cookies
# Must match the secret set on the gallery-media-guard Cloudflare Worker
# (workers/gallery-media-guard) via `wrangler secret put R2_EDGE_SIGNING_SECRET` —
# signs the short-lived previews/watermarked URLs the Worker validates at the edge.
R2_EDGE_SIGNING_SECRET=random-secret-for-r2-edge-signing

# Email — transactional send. Swap the vendor without touching any send code:
# set EMAIL_PROVIDER to a name registered in lib/email/provider-factory.ts.
EMAIL_PROVIDER=resend
EMAIL_FROM=Studio Galleries <noreply@yourdomain.com>
# resend provider
RESEND_API_KEY=re_xxxxxxxx
# mailjet provider — set EMAIL_PROVIDER=mailjet to use it instead (key pair)
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_SECRET_KEY=your-mailjet-secret-key
# Optional automatic failover: when the primary hits its quota / rate limit / 5xx,
# roll over to this provider. Needs both providers' keys. A quota failure parks
# the primary for EMAIL_FAILOVER_COOLDOWN_MINUTES (default 60) before re-probing.
EMAIL_FALLBACK_PROVIDER=mailjet
# EMAIL_FAILOVER_COOLDOWN_MINUTES=60
# Required in production — also determines who is allowed to log into /manage
FEEDBACK_EMAIL=lea0556769466@gmail.com
ADMIN_NAME=לאה

# Dashboard AI assistant — server only. Without credentials the chat widget
# shows a friendly "not configured" error instead of the chat panel.
# Provider selection — swap the model vendor without touching any assistant
# code: set this to a registered provider id (see lib/assistant/provider/index.ts).
ASSISTANT_AI_PROVIDER=anthropic
# anthropic provider
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional — override the anthropic provider's default model id
# ASSISTANT_MODEL_ID=claude-opus-5
# gemini provider — set ASSISTANT_AI_PROVIDER=gemini to use it instead
GEMINI_API_KEY=your-gemini-api-key
# Optional — override the gemini provider's default model id
# ASSISTANT_GEMINI_MODEL_ID=gemini-2.5-flash

# Cloudflare R2 — photo files (records stay in Supabase)
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=albums
NEXT_PUBLIC_R2_PUBLIC_URL=https://albums.studio-galleries.com
# Optional server-side fallback (same value as NEXT_PUBLIC_R2_PUBLIC_URL)
R2_PUBLIC_URL=https://albums.studio-galleries.com

# Vercel API — photographer custom domains (e.g. johnphoto.com), attached
# directly to this project so Vercel serves and auto-provisions SSL for them.
# Without these, the "דומיין אישי" dashboard section stays hidden.
VERCEL_API_TOKEN=your-vercel-api-token
VERCEL_PROJECT_ID=prj_xxxxxxxx
# Only required if the Vercel project lives under a Team, not a personal account.
VERCEL_TEAM_ID=

# Payments — server only unless explicitly documented otherwise
# Required for PayMe checkout.
PAYMENT_PROVIDER=payme
# Sandbox only. Live (live.payme.io) is rejected by the client.
PAYME_ENV=sandbox
PAYME_API_BASE_URL=https://sandbox.payme.io/api
# Optional partner/platform key. Regular Seller sandbox flows can work with seller_payme_id only.
PAYME_CLIENT_KEY=
PAYME_SELLER_ID=
# Reserved for future payme_signature verification (algorithm not yet provided)
PAYME_WEBHOOK_SECRET=
# Feature flags — only the exact string "true" enables each flag
# Reminders master switch. When true and checkout is false → soft update email
# (≤3 days left). When true and checkout is true → payment reminder (day+3).
TRIAL_ENDING_REMINDERS_ENABLED=false
# Keep false in Vercel Production until sandbox checkout is approved.
PAYMENTS_CHECKOUT_ENABLED=false
ENFORCE_SUBSCRIPTION_ACCESS=false
